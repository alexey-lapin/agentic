#!/bin/sh
# Refuse to delete the promotion branch. Override: git -c core.hooksPath=/dev/null ...
[ "$1" = "prepared" ] || exit 0
while read -r old new ref; do
    case "$ref" in
        refs/heads/promotion)
            case "$new" in
                *[!0]*) ;;
                ?*) echo "reference-transaction: refusing to delete refs/heads/promotion." >&2
                    echo "  Override: git -c core.hooksPath=/dev/null branch -D promotion" >&2
                    exit 1 ;;
            esac
            ;;
    esac
done
exit 0
